<h1><%= @blog.title %></h1>
<p>by <%= @blog.user.username %></p>
<p><%= @blog.body %></p>

<h2>Comments</h2>
<% @blog.comments.each do |comment| %>
  <p>
    <strong><%= comment.user.username %>:</strong> <%= comment.body %>
    <% if can? :destroy, comment %>
      <%= link_to "Delete", blog_comment_path(@blog, comment), method: :delete, data: { confirm: "Are you sure?" } %>
    <% end %>
  </p>
<% end %>

<% if user_signed_in? %>
  <%= form_with(model: [@blog, Comment.new]) do |f| %>
    <%= f.text_area :body %><br>
    <%= f.submit "Add Comment" %>
  <% end %>
<% else %>
  <p>You must <%= link_to "log in", new_user_session_path %> to comment.</p>
<% end %>
